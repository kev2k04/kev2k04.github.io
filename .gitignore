# Jekyll build output & caches
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ruby / Bundler
Gemfile.lock
vendor/
.bundle/

# Local-only dev shims (e.g. tainted? compat for running old gems on Ruby 4)
.local/

# Node / serverless API deps & secrets
node_modules/
.env
.env.*
!.env.example
.vercel/
.netlify/

# Audio: only the trimmed preview clips ship. Full-song masters dropped into
# assets/audio/ (any other name) stay local and are never published.
assets/audio/*.mp3
!assets/audio/pink-noise.mp3
!assets/audio/catseye.mp3
!assets/audio/neverless.mp3
!assets/audio/exotic.mp3
!assets/audio/flashing-lights.mp3
!assets/audio/neverless-cinematic.mp3
!assets/audio/exodia.mp3
!assets/audio/stay.mp3
!assets/audio/worlds-away.mp3

# Original photo drop (heic/mov, large) — only the converted web assets in
# assets/images/website-design/ ship.
assets/images/website design photos/
*.heic

# OS / editor cruft
.DS_Store
Thumbs.db
*~

# Original camera uploads (processed web copies are committed instead).
# These are multi-megabyte masters — keep them outside the repo entirely so a
# stray `git add -A` can never bake them into history.
assets/images/Seaspan Pictures/
assets/images/Open Robotics Arm.jpg
assets/images/headshot professional.jpeg
assets/images/BC Hydro desk.jpg
assets/images/BC Hydro Wallpaper.jpg
assets/images/bc hydro elevator.jpg
assets/images/boat picture.heic
assets/images/joshua tree.jpg
assets/images/me sunset.jpg
assets/images/kevin.jpeg
# Convention: originals keep their camera / space-separated filename; the
# shipped web copy is the hyphenated one (headshot-professional.jpg etc.).
